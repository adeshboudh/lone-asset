[sub_resource type="Shader" id="vignette_shader"]
code = "shader_type canvas_item;
void fragment() {
	float d = distance(UV, vec2(0.5));
	float edge = smoothstep(0.28, 0.62, d);
	COLOR = vec4(0.0, 0.0, 0.0, edge * 0.85);
}
"

