; Engine configuration file.
; Settings documented in docs/design/m1-technical-design.md §1.2.

config_version=5

[application]

config/name="Lone Asset"
config/description="Tactical stealth FPS for the web browser."
config/version="dev"
run/main_scene="res://game/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Log="*res://game/autoload/log.gd"
Platform="*res://game/autoload/platform.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
