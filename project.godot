; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lone Asset"
config/description="Tactical stealth FPS for the web browser."
config/version="dev"
run/main_scene="res://game/ui/title/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Log="*res://game/autoload/log.gd"
Platform="*res://game/autoload/platform.gd"
EventBus="*res://game/autoload/event_bus.gd"
Settings="*res://game/autoload/settings.gd"
Mission="*res://game/autoload/mission_service.gd"
Saves="*res://game/autoload/save_service.gd"
Game="*res://game/autoload/game.gd"
NoiseSystem="*res://game/autoload/noise_system.gd"
Audio="*res://game/autoload/audio.gd"
PerceptionScheduler="*res://game/autoload/perception_scheduler.gd"
DebugViews="*res://game/debug/debug_views.gd"

[audio]

buses/default_bus_layout="res://game/audio/default_bus_layout.tres"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

